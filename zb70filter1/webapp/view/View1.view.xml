<mvc:View controllerName="com.demo.zb70filter1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"    xmlns:f="sap.ui.layout.form" 
     xmlns:core="sap.ui.core" xmlns:fb="sap.ui.comp.filterbar" >
    <Page id="page" title="{i18n>title}">
     <content>

           <!-- 1. Added FilterBar Utility Control -->
            <fb:FilterBar id="idFilterBar" persistencyKey="myFilterBarKey" useToolbar="false" search=".onFilterSearch" filterContainerWidth="14rem">
                <fb:filterGroupItems>
                    
                    <!-- Filter Group Item for Status Dropdown -->
                    <fb:FilterGroupItem name="Status" label="Status" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <ComboBox id="idStatusFilter" placeholder="Select Status">
                                <core:Item key="Active" text="Active"/>
                                <core:Item key="Inactive" text="Inactive"/>
                                <core:Item key="Pending" text="Pending"/>
                            </ComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>

                    <!-- Filter Group Item for Skill Dropdown -->
                    <fb:FilterGroupItem name="Skill" label="Skill" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            /SkillSet}" -->
                            <ComboBox id="idSkillFilter" placeholder="Select Skill">
                                <core:Item key="ABAP" text="ABAP"/>
                                <core:Item key="UI5" text="SAPUI5 / Fiori"/>
                                <core:Item key="HANA" text="SAP HANA"/>
                            </ComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>

                </fb:filterGroupItems>
            </fb:FilterBar>




     <Table id="idtable" items="{oModel>/EmployeeSet}">
       <headerToolbar>
        <Toolbar id="idtoolbar">
            <Title id="idtitle" text="Employees list"></Title>
           
        </Toolbar>
       </headerToolbar>
       <columns>
            <Column id="idcolumn">
            <Text id="idtext1" text="Employee id"></Text>
            </Column>

            <Column id="idcolumn1">
             <Text id="idtext2" text="Employee name"></Text>
             </Column>

            <Column id="idcolumn3">
             <Text id="idtext3" text="Designation"></Text>
             </Column>

             <Column id="idcolumn4">
              <Text id="idtext4" text="Skill"></Text>
             </Column>
            <Column id="idcolumn5">
               <Text id="idtext5" text="Email"></Text>
            </Column>

             <Column id="idcolumn6">
              <Text id="idtext6" text="Phone"></Text>
              </Column>

               <Column id="idcolumn7">
              <Text id="idtext7" text="Salary"></Text>
              </Column>
           
            <Column id="idcolumn9">
              <Text id="idtext9" text="DOBJ"></Text>
              </Column>

             <Column id="idcolumn10">
              <Text id="idtext10" text="Rating"></Text>
              </Column>
             <Column id="idcolumn11">
              <Text id="idtext11" text="Status"></Text>
              </Column>

       </columns>
       <items>
        <ColumnListItem id="columnlistitem">

            <cells>
                <Text id="text1" text="{oModel>Empid}"/>
                <Text id="text2" text="{oModel>Name}"/>
                <Text id="text3" text="{oModel>Desig}"/> 
                <Text id="text4" text="{oModel>Skill}"/>  
                <Text id="text5" text="{oModel>Email}"/>
                <Text id="text6" text="{oModel>Phone}"/>
                 <Text id="text7" text="{oModel>Salary}"/>
                <Text id="text8" text="{oModel>Doj}"/>
                <Text id="text9" text="{oModel>Rating}"/>
                <Text id="text10" text="{oModel>Status}"/>
            </cells>
        </ColumnListItem>
       </items>

     </Table>
    </content>
    <footer>
        <Bar id="idbar">
            <contentRight>
             <Button id="Button" text="Submit" type="Accept" press="onSubmit" ></Button>
           <!--   <Button id="button1" text="Press" type="Accept" press="onpress"></Button> -->
            </contentRight>
        </Bar>
    </footer>
    </Page>
</mvc:View>

