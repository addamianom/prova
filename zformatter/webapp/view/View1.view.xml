<mvc:View controllerName="com.demo.zformatter.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"    xmlns:f="sap.ui.layout.form"  xmlns:core="sap.ui.core" >
    <Page id="page" title="{i18n>title}">
     <content>
        <ScrollContainer id="scroll" horizontal="true" vertical="true">
     <Table id="idtable" items="{oModel>/EmployeeSet}">
       <headerToolbar>
        <Toolbar id="idtoolbar">
            <Title id="idtitle" text="Employees list"></Title>
        </Toolbar>
       </headerToolbar>
       <columns>
            <Column id="idcolumn" width="15rem">
            <Text id="idtext1" text="Employee id"></Text>
            </Column>

            <Column id="idcolumn1" width="15rem">
             <Text id="idtext2" text="Employee name"></Text>
             </Column>

            <Column id="idcolumn3" width="10rem">
             <Text id="idtext3" text="Designation"></Text>
             </Column>

             <Column id="idcolumn4" width="15rem">
              <Text id="idtext4" text="Skill"></Text>
             </Column>
            <Column id="idcolumn5" width="15rem">
               <Text id="idtext5" text="Email"></Text>
            </Column>

             <Column id="idcolumn6" width="10rem">
              <Text id="idtext6" text="Phone"></Text>
              </Column>

               <Column id="idcolumn7" width="10rem">
              <Text id="idtext7" text="Salary"></Text>
              </Column>
           
            <Column id="idcolumn9" width="10rem">
              <Text id="idtext9" text="DOBJ" width="10rem"></Text>
              </Column>

             <Column id="idcolumn10" width="10rem">
              <Text id="idtext10" text="Rating" width="10rem"></Text>
              </Column>
             <Column id="idcolumn11" width="10rem">
              <Text id="idtext11" text="Status" width="10rem"></Text>
              </Column>

       </columns>
       <items>
        <ColumnListItem id="columnlistitem">

            <cells>
                <Text id="text1" text="{oModel>Empid}"/>
                <Text id="text2" text="{path:'oModel>Name', formatter:'.f.formatName'}"/>
                <Text id="text3" text="{oModel>Desig}"/> 
  <ObjectStatus id="objectstatus"
         text="{oModel>Skill}" state="{path:'oModel>Skill',formatter:'.f.colorSkill'}"> </ObjectStatus>
           <!--    <text id="text4" text="{oModel></text>Skill}"/> -->
                <Text id="text5" text="{oModel>Email}"/>
                <Text id="text6" text="{oModel>Phone}"/>
                 <Text id="text7" text="{oModel>Salary}"/>
                <Text id="text8" text="{path:'oModel>Doj', formatter:'.f.DateFormat'}"/>
                  <!--  <Text id="text8" text="{oModel>Doj}"/> -->
                <Text id="text9" text="{oModel>Rating}"/>

 <ObjectStatus id="objectstatus1"
  text="{oModel>Status}" state="{path:'oModel>Status',formatter:'.f.colorStatus'}"> </ObjectStatus>
               <!-- <Text id="text10" text="{oModel>Status}"/> -->
            </cells>
        </ColumnListItem>
       </items>

     </Table>
     </ScrollContainer>
    </content>
    <footer>
        <Bar id="idbar">
            <contentRight>
             <Button id="Button" text="Submit" type="Accept" press="onSubmit" ></Button>
           <!--   <Button id="button1" text="Press" type="Accept" press="onpress"></Button> -->
            </contentRight>
        </Bar>
    </footer>
    </Page>
</mvc:View>
