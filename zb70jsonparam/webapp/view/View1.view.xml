<mvc:View controllerName="zb70jsonparam.controller.View1"
      xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"  xmlns:f="sap.ui.layout.form"   xmlns:core="sap.ui.core" >
    <Page id="page" title="{i18n>title}">

     <content>

  <f:SimpleForm id="simpleform"  title="Orders" editable="true" layout="ResponsiveGridLayout" 
    labelSpanL="4" labelSpanM="4" emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="2" >
    <f:content>
    <core:Title text="Order Details"  id="idgrp1" ></core:Title>
     <Label id="idid" text="id"></Label>
    <Input id="inpid" ></Input>
    <Label id="labelOrderno" text="Orderno"></Label>
    <Input id="inpOrderno" ></Input>
     <Label id="labelOrderType" text="OrderType"></Label>
    <Input id="inpOrderType" ></Input>
    <core:Title text="Other Details"  id="idgrp2" ></core:Title>
     <Label id="labelCustomer" text="Customer"></Label>
    <Input id="inpCustomer" ></Input>
     <Label id="labelGrossAmt" text="GrossAmt"></Label>
    <Input id="inpGrossAmt" ></Input>
      <core:Title text="Currency Details"  id="idgrp3" ></core:Title>
     <Label id="labelCurrencyUnit" text="CurrencyUnit"></Label>
    <Input id="inpCurrencyUnit" ></Input>
    </f:content>
    </f:SimpleForm>

    </content>
    <footer>
        <Bar id="idbar">
            <contentRight>
             <Button id="Button" text="Submit" type="Accept" press="onSubmit" ></Button>
           <!--   <Button id="button1" text="Press" type="Accept" press="onpress"></Button> -->
            </contentRight>
        </Bar>
    </footer>

    </Page>
</mvc:View>