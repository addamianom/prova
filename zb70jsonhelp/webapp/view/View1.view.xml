<mvc:View xmlns:uxap="sap.uxap" controllerName="com.demo.zb70jsonhelp.controller.View1"
  xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core" 
    displayBlock="true">
    <Page id="page" title="{i18n>title}">  
     <content>
<f:SimpleForm id="simpleform"  title="Orders" editable="true" layout="ResponsiveGridLayout" 
    labelSpanL="1" labelSpanM="1" emptySpanL="8" emptySpanM="8" columnsL="3" columnsM="2" >
    <f:content>
    <core:Title text="Order Details"  id="idgrp1" ></core:Title>
    <Label id="labelOrderno" text="Orderno"></Label>
    <Input id="inpOrderno" class="sapUiLargeMarginBottom" 
    showValueHelp="true" valueHelpRequest="onValueHelpPress"></Input>
    
</f:content>
    </f:SimpleForm>

      <Table id="table" items="{empModel>/results} "
      mode="SingleSelectMaster" selectionChange="onSelEmp">

      <headerToolbar>
         <Toolbar id="idtoolbar">
            <Title id="idtitle" text="Employees list"></Title>
            <ToolbarSpacer id="spacer"></ToolbarSpacer>
            <SearchField id= "search" width="30%" liveChange="onSearch"></SearchField>
            <Button id="but1" icon="sap-icon://sort-ascending" press="sortAsc"></Button>
             <Button id="but2" icon="sap-icon://sort-descending" press="sortDesc"></Button>
        </Toolbar>
     </headerToolbar>

       <columns>
            <Column id="idcolumn">
            <Text id="idtext1" text="Employee id"></Text>
            </Column>

            <Column id="idcolumn1">
             <Text id="idtext2" text="Employee name"></Text>
             </Column>

            <Column id="idcolumn3">
             <Text id="idtext3" text="Designation"></Text>
             </Column>

             <Column id="idcolumn4">
              <Text id="idtext4" text="Skill"></Text>
             </Column>
            <Column id="idcolumn5">
               <Text id="idtext5" text="Email"></Text>
            </Column>

             <Column id="idcolumn6">
              <Text id="idtext6" text="Phone"></Text>
              </Column>

               <Column id="idcolumn7">
              <Text id="idtext7" text="Salary"></Text>
              </Column>
           
            <Column id="idcolumn9">
              <Text id="idtext9" text="DOBJ"></Text>
              </Column>

             <Column id="idcolumn10">
              <Text id="idtext10" text="Rating"></Text>
              </Column>
             <Column id="idcolumn11">
              <Text id="idtext11" text="Status"></Text>
              </Column>

       </columns>
       <items>
        <ColumnListItem id="columnlistitem">
            <cells>
                <Text id="text1" text="{empModel>Empid}"/>
                <Text id="text2" text="{path:'Name', formatter:'.f.formatName'}"/>
                <Text id="text3" text="{empModel>Desig}"/> 
  <ObjectStatus id="objectstatus"
         text="{empModel>Skill}" state="{path:'Skill',formatter:'.f.colorSkill'}"> </ObjectStatus>
           <!--    <text id="text4" text="{empModel></text>Skill}"/> -->
                <Text id="text5" text="{empModel>Email}"/>
                <Text id="text6" text="{PempModel>hone}"/>
                 <Text id="text7" text="{empModel>Salary}"/>
                <Text id="text8" text="{path:'empModel>Doj', formatter:'.f.DateFormat'}"/>
                  <!--  <Text id="text8" text="{oModel>Doj}"/> -->
                <Text id="text9" text="{empModel>Rating}"/>

 <ObjectStatus id="objectstatus1"
  text="{empModel>Status}" state="{path:'Status',formatter:'.f.colorStatus'}"> </ObjectStatus>
               <!-- <Text id="text10" text="{oModel>Status}"/> -->
            </cells>
        </ColumnListItem>
       </items>

     </Table>

    </content>

    <footer>
        <Bar id="idbar">
            <contentRight>
             <Button id="Button" text="Submit" type="Accept" press="onPress"  ></Button>
           <!--   <Button id="button1" text="Press" type="Accept" press="onpress"></Button> -->
            </contentRight>
        </Bar>
    </footer>
    </Page>
</mvc:View>
